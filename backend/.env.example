# Copy to .env and fill in. Never commit .env.

# Server
PORT=8080
# URL of the frontend that may call the API
CORS=http://localhost:5173

# PostgreSQL ("db" when running with docker compose, otherwise usually localhost)
HOST=localhost
USER_NAME=postgres
PASSWORD=change-me
DB_NAME=postgres

# JWT secrets: long random strings, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Supabase Storage (public bucket "winku" with default/pfp.jpg and default/cover.jpg)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=
SUPABASE_IMAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/

# Optional
# NODE_ENV=production
# TRUST_PROXY=1
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_SECURE=true
